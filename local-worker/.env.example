# Skopiuj do .env i uzupełnij. .env jest już w .gitignore (patrz reguła
# ".env" / ".env.*" w root .gitignore) — nigdy nie commituj prawdziwych wartości.

# Te same wartości co VITE_SUPABASE_URL / klucz anon we frontendzie
# (Supabase → Project Settings → API). To CELOWO klucz anon, nie service
# role — worker loguje się jako zwykły użytkownik, więc RLS ogranicza go
# tak samo jak przeglądarkę.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Konto, którym worker się loguje — to samo, którym logujesz się w appce.
JARVIS_EMAIL=you@example.com
JARVIS_PASSWORD=your-password

# Katalog na Twoim komputerze, w którym worker wolno mu czytać/zapisywać
# pliki. Wszystkie ścieżki z narzędzia run_local_action są względne wobec
# tego katalogu — nic poza nim nie jest osiągalne. Domyślnie ~/Jarvis.
JARVIS_WORKDIR=/home/you/Jarvis
